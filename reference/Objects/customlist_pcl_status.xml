  <isinactive>F</isinactive>
  <isordered>F</isordered>
  <customvalues>
    <customvalue scriptid="val_pcl_pending">
      <value>Pending</value>
      <abbreviation>P</abbreviation>
      <isinactive>F</isinactive>
    </customvalue>
    <customvalue scriptid="val_pcl_running">
      <value>Running</value>
      <abbreviation>R</abbreviation>
      <isinactive>F</isinactive>
    </customvalue>
    <customvalue scriptid="val_pcl_completed">
      <value>Completed</value>
      <abbreviation>C</abbreviation>
